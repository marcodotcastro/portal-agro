<!-- Destaque Principal da Cooperativa -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-12 col-lg-7 ml-auto order-lg-2 position-relative mb-5" data-aos="fade-up">
        <div class="p-5 rounded text-white shadow" style="background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);">
          <span class="badge badge-warning text-dark font-weight-bold mb-3 text-uppercase">Destaque da Safra Atual</span>
          <% if @product %>
            <h2 class="text-white font-weight-bold mb-2"><%= @product.name %></h2>
            <p class="text-white-50 mb-3"><%= truncate(@product.description, length: 140) %></p>
            <div class="d-flex justify-content-between align-items-center border-top border-white-50 pt-3">
              <div>
                <span class="small text-white-50 d-block">Preço Base</span>
                <h4 class="text-white font-weight-bold mb-0">R$ <%= sprintf('%.2f', @product.price) %></h4>
              </div>
              <div class="btn-group">
                <%= link_to "Ver Safra", product_path(@product), class: "btn btn-outline-light btn-sm font-weight-bold" %>
                <%= link_to "Simular Compra", new_order_path(product_id: @product.id), class: "btn btn-success btn-sm font-weight-bold" %>
              </div>
            </div>
          <% else %>
            <h2 class="text-white font-weight-bold">Portal Agro Cooperativa</h2>
            <p class="text-white-50">Conectando compradores a pequenos e médios produtores com rastreabilidade total.</p>
          <% end %>
        </div>
      </div>
      <div class="col-md-12 col-lg-4 order-lg-1" data-aos="fade-up">
        <h2 class="font-weight-bold text-dark mb-3">Agricultura Inteligente & Rastreabilidade</h2>
        <p class="text-muted leading-relaxed mb-4">
          A plataforma digital da cooperativa permite consultar lotes de safras, simular contratos e negociar diretamente com produtores certificados.
        </p>
        <div class="d-flex flex-column gap-2">
          <%= link_to "Explorar Catálogo de Safras", products_path, class: "btn btn-success btn-block py-3 font-weight-bold shadow-sm mb-2" %>
          <%= link_to "Simular Pedido / Cotação", new_order_path, class: "btn btn-outline-primary btn-block py-2 font-weight-bold mb-2" %>
          <%= link_to "Conhecer Produtores", producers_path, class: "btn btn-outline-secondary btn-block py-2 font-weight-bold" %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Safras e Produtos em Destaque -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center text-center mb-5">
      <div class="col-md-8">
        <h2 class="font-weight-bold text-dark" data-aos="fade-up">Safras & Lotes em Comercialização</h2>
        <p class="text-muted" data-aos="fade-up" data-aos-delay="100">Grãos, hortifrúti e produtos agropecuários prontos para negociação com entrega garantida.</p>
      </div>
    </div>
    <div class="row">
      <% if @products.any? %>
        <%= render partial: "products/product", collection: @products, as: :product %>
      <% else %>
        <div class="col-12 text-center py-4">
          <p class="text-muted">Nenhum produto cadastrado no momento.</p>
        </div>
      <% end %>
    </div>
    <div class="text-center mt-3">
      <%= link_to "Ver Catálogo Completo com Busca Reativa →", products_path, class: "btn btn-outline-success font-weight-bold px-4 py-2" %>
    </div>
  </div>
</section>

<!-- Produtores Rurais Associados -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row justify-content-center text-center mb-5">
      <div class="col-md-8">
        <h2 class="font-weight-bold text-dark" data-aos="fade-up">Produtores & Cooperados</h2>
        <p class="text-muted" data-aos="fade-up" data-aos-delay="100">Fazendas e produtores comprometidos com as melhores práticas agrícolas e sustentabilidade.</p>
      </div>
    </div>
    <div class="row">
      <% if @producers.any? %>
        <%= render partial: "producers/producer", collection: @producers, as: :producer %>
      <% else %>
        <div class="col-12 text-center py-4">
          <p class="text-muted">Nenhum produtor associado cadastrado no momento.</p>
        </div>
      <% end %>
    </div>
    <div class="text-center mt-3">
      <%= link_to "Conhecer Todos os Produtores →", producers_path, class: "btn btn-outline-primary font-weight-bold px-4 py-2" %>
    </div>
  </div>
</section>

<!-- Serviços Técnicos -->
<% if @services.any? %>
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row justify-content-center text-center mb-5">
        <div class="col-md-8">
          <h2 class="font-weight-bold text-dark" data-aos="fade-up">Serviços Agrícolas Especializados</h2>
          <p class="text-muted" data-aos="fade-up" data-aos-delay="100">Assistência técnica, manejo de solo, pulverização e telemetria para cooperados.</p>
        </div>
      </div>
      <div class="row">
        <%= render partial: "services/service", collection: @services, as: :service %>
      </div>
    </div>
  </section>
<% end %>