<div class="col-md-6 col-lg-4 mb-5" data-aos="fade-up">
  <div class="card h-100 shadow-sm border-0 rounded overflow-hidden">
    <div style="height: 180px; background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%); display: flex; align-items: center; justify-content: center; color: white;">
      <div class="text-center px-3">
        <span class="badge badge-light text-primary mb-2">Serviço Técnico</span>
        <h4 class="text-white font-weight-bold mb-0"><%= service.name %></h4>
      </div>
    </div>
    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">Prestador:</span>
        <strong class="text-dark"><%= service.producer&.name || 'Cooperativa Central' %></strong>
      </div>
      <p class="text-muted small mb-3 flex-grow-1"><%= truncate(service.description, length: 90) %></p>

      <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small d-block">Preço Base</span>
          <strong class="text-success">R$ <%= sprintf('%.2f', service.price || 0) %> <%= "/ #{service.unit}" if service.unit.present? %></strong>
        </div>
        <%= link_to "Ver Detalhes", service_path(service), class: "btn btn-outline-primary btn-sm font-weight-bold" %>
      </div>
    </div>
  </div>
</div>
