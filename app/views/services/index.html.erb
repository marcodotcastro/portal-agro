<section class="py-5 bg-light">
  <div class="container">
    <div class="row mb-4 align-items-center">
      <div class="col-md-8">
        <h2 class="font-weight-bold text-dark mb-1">Serviços Agrícolas e Assistência Técnica</h2>
        <p class="text-muted mb-0">Serviços prestados por associados e técnicos da cooperativa para sua lavoura.</p>
      </div>
      <div class="col-md-4 text-md-right mt-3 mt-md-0">
        <%= link_to "Fale com um Especialista", new_contact_path, class: "btn btn-outline-success px-4 py-2 font-weight-bold" %>
      </div>
    </div>

    <div class="row">
      <% if @services.any? %>
        <%= render partial: "service", collection: @services, as: :service %>
      <% else %>
        <div class="col-12 py-5 text-center">
          <div class="p-5 bg-white rounded shadow-sm">
            <h4 class="text-secondary font-weight-bold">Nenhum serviço disponível no momento</h4>
            <p class="text-muted">Consulte a diretoria técnica da cooperativa para novas modalidades.</p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="row justify-content-center mt-4">
      <%= paginate @services if @services.respond_to?(:total_pages) %>
    </div>
  </div>
</section>
